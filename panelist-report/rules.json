  "various_label": "Various topics",
  "anomaly": {
    "_comment": "A period-over-period move is only flagged when it clears BOTH a percentage and an absolute-case threshold, so small counts cannot manufacture a scary percentage.",
    "pct_threshold": 25,
    "min_abs_change": 5,
    "bucket_pct_threshold": 40,
    "bucket_min_abs": 5,
    "z_threshold": 2.0,
    "min_periods_for_z": 4,
    "peak_ratio": 1.5,
    "peak_min": 5,
    "trend_pct": 15
  },
